{
  "name": "vgo-code",
  "version": "1.3.2",
  "description": "VGO CODE desktop agent workspace.",
  "main": "electron/main.js",
  "author": "VGO CODE",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://vgo-code.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sujay888999/vgo-code.git"
  },
  "bugs": {
    "url": "https://github.com/sujay888999/vgo-code/issues"
  },
  "scripts": {
    "dev": "npm run build:web && electron .",
    "start": "npm run build:web && electron .",
    "build:web": "npm --prefix ./src run build",
    "pack": "npm run build:web && electron-builder --win dir",
    "dist": "npm run build:web && electron-builder --win nsis",
    "verify:release": "powershell -ExecutionPolicy Bypass -File ./scripts/release-check.ps1",
    "release:single": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-single-version-release.ps1 -LocalOnly",
    "release:remote": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-single-version-release.ps1",
    "test:protocol": "node ./scripts/test-agent-protocol.js"
  },
  "build": {
    "appId": "com.vgo.code",
    "productName": "VGO CODE",
    "files": [
      "electron/**/*",
      "build/**/*",
      "server/**/*",
      "vendor/package/**/*",
      "dist-web/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/package/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "./scripts/afterPack.js"
  },
  "devDependencies": {
    "electron": "^36.3.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "dependencies": {}
}
